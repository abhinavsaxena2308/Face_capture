# PostgreSQL must already be running locally or be reachable on your network.
# URL-encode a password that contains @, :, /, or #.
DATABASE_URL=postgresql+psycopg://facefinder:CHANGE_ME@127.0.0.1:5432/facefinder

APP_DATA_DIR=C:/Users/Admin/AppData/Local/FaceFinder/data
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:4300,http://localhost:4300

# CPU-only v1: leave this at one worker process. The worker loads both ONNX models once.
CPU_WORKERS=1
WORKER_POLL_SECONDS=2
STALE_JOB_MINUTES=15

MAX_COLLECTION_FILES=25000
MAX_FILE_MB=50
MAX_BATCH_FILES=25
MAX_BATCH_MB=200

# Downloaded models live outside Git under APP_DATA_DIR\\models.
MODEL_DIR=C:/Users/Admin/AppData/Local/FaceFinder/data/models
YUNET_MODEL=face_detection_yunet_2023mar.onnx
SFACE_MODEL=face_recognition_sface_2021dec.onnx
DETECTOR_SCORE_THRESHOLD=0.9
DETECTOR_NMS_THRESHOLD=0.3
MIN_TARGET_FACE_PIXELS=40
MIN_REFERENCE_FACE_PIXELS=80

# SFace cosine-similarity presets. The UI sends broad, balanced, or strict.
MATCH_THRESHOLD_BROAD=0.32
MATCH_THRESHOLD_BALANCED=0.363
MATCH_THRESHOLD_STRICT=0.45
